// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  INSTRUCTOR
  RECEPTIONIST
  FINANCIAL
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlanType {
  BASICO_4
  BASICO_8
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENCE
}

enum MonthlyFeeStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
}

// ============================================================================
// MODELS
// ============================================================================

/// Usuários do sistema (4 roles: Admin, Professor, Recepcionista, Financeiro)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  full_name     String
  password_hash String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relationships
  student       Student?
  instructor    Instructor?
  audit_logs    AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
}

/// Dados estendidos de alunos (1:1 com User)
model Student {
  id              String  @id @default(cuid())
  user_id         String  @unique
  phone           String?
  date_of_birth   DateTime?
  gender          Gender?
  address         String?
  emergency_contact String?
  medical_info    String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  user            User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plans           StudentPlan[]
  progress        StudentProgress[]
  attendances     Attendance[]
  monthly_fees    MonthlyFee[]
  payments        Payment[]

  @@index([user_id])
}

/// Dados estendidos de professores (1:1 com User)
model Instructor {
  id              String  @id @default(cuid())
  user_id         String  @unique
  specialization  String?
  license_number  String?
  phone           String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  user            User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  class_schedules ClassSchedule[]
  classes         Class[]

  @@index([user_id])
}

/// Planos de alunos (BASICO_4, BASICO_8, PREMIUM)
model StudentPlan {
  id              String    @id @default(cuid())
  student_id      String
  plan_type       PlanType
  monthly_cost    Decimal   @db.Decimal(10, 2)
  classes_per_week Int
  status          StudentPlanStatus @default(ACTIVE)
  start_date      DateTime
  end_date        DateTime
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  student         Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  monthly_fees    MonthlyFee[]

  @@index([student_id])
  @@index([status])
  @@index([plan_type])
}

/// Progresso e avaliações do aluno
model StudentProgress {
  id              String   @id @default(cuid())
  student_id      String
  evaluation_date DateTime
  body_measurements String? // JSON com medidas
  notes           String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  student         Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([evaluation_date])
}

/// Horários recorrentes de aulas (seg-dom)
model ClassSchedule {
  id              String  @id @default(cuid())
  instructor_id   String
  day_of_week     DayOfWeek
  start_time      DateTime @db.Time
  end_time        DateTime @db.Time
  room            String
  capacity        Int
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  instructor      Instructor @relation(fields: [instructor_id], references: [id], onDelete: Cascade)
  classes         Class[]

  @@unique([instructor_id, day_of_week, start_time])
  @@index([instructor_id])
  @@index([day_of_week])
}

/// Aulas (ocorrências específicas, cada data)
model Class {
  id                String    @id @default(cuid())
  class_schedule_id String
  instructor_id     String
  class_date        DateTime
  status            ClassStatus @default(SCHEDULED)
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  // Relationships
  class_schedule    ClassSchedule @relation(fields: [class_schedule_id], references: [id], onDelete: Cascade)
  instructor        Instructor    @relation(fields: [instructor_id], references: [id], onDelete: Cascade)
  attendances       Attendance[]

  @@index([class_schedule_id])
  @@index([instructor_id])
  @@index([class_date])
  @@index([status])
}

/// Presenças em aulas
model Attendance {
  id              String    @id @default(cuid())
  class_id        String
  student_id      String
  status          AttendanceStatus @default(ABSENT)
  notes           String?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  class           Class     @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@index([class_id])
  @@index([student_id])
  @@index([status])
}

/// Mensalidades (geradas automaticamente a cada mês)
model MonthlyFee {
  id              String    @id @default(cuid())
  student_id      String
  student_plan_id String
  month_year      DateTime  @db.Date
  amount          Decimal   @db.Decimal(10, 2)
  status          MonthlyFeeStatus @default(PENDING)
  due_date        DateTime
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  student         Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  student_plan    StudentPlan @relation(fields: [student_plan_id], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@unique([student_id, month_year])
  @@index([student_id])
  @@index([status])
  @@index([month_year])
  @@index([due_date])
}

/// Registros de pagamento
model Payment {
  id                String       @id @default(cuid())
  monthly_fee_id    String
  student_id        String
  amount            Decimal      @db.Decimal(10, 2)
  payment_method    PaymentMethod
  payment_date      DateTime
  transaction_id    String?
  notes             String?
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  // Relationships
  monthly_fee       MonthlyFee @relation(fields: [monthly_fee_id], references: [id], onDelete: Cascade)
  student           Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  cash_register     CashRegister[]

  @@index([monthly_fee_id])
  @@index([student_id])
  @@index([payment_method])
  @@index([payment_date])
}

/// Caixa diário
model CashRegister {
  id                String      @id @default(cuid())
  payment_id        String
  amount            Decimal     @db.Decimal(10, 2)
  status            CashRegisterStatus @default(OPEN)
  opened_at         DateTime @default(now())
  closed_at         DateTime?
  notes             String?
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  // Relationships
  payment           Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([status])
  @@index([opened_at])
}

/// Notificações automáticas (mensalidades vencidas, reposição, etc)
model Notification {
  id              String   @id @default(cuid())
  user_id         String
  notification_type NotificationType
  message         String
  read            Boolean  @default(false)
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  // Relationships
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([read])
}

/// Auditoria (rastreamento de ações)
model AuditLog {
  id              String   @id @default(cuid())
  user_id         String
  action          AuditAction
  entity_type     String
  entity_id       String
  changes         String?  // JSON com mudanças
  ip_address      String?
  user_agent      String?
  
  created_at      DateTime @default(now())
  
  // Relationships
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([entity_type])
  @@index([created_at])
}
