# ============================================================================
# TEMPLATE de variáveis de PRODUÇÃO — copie para ".env.production" e preencha
# com valores reais. NUNCA commite ".env.production" com segredos reais.
#
# Uso:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ============================================================================

# ====== AMBIENTE ======
NODE_ENV=production

# ====== BANCO DE DADOS (MySQL) ======
# Credenciais do container mysql do docker-compose.prod.yml
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=pilates_db
MYSQL_USER=pilates_user
MYSQL_PASSWORD=

# String de conexão usada pelo Prisma — host "mysql" é o nome do serviço na
# rede interna do Docker Compose. Deve ser consistente com as credenciais acima.
# Formato: mysql://usuario:senha@mysql:3306/database
DATABASE_URL=

# ====== JWT ======
# Gerar secrets fortes e DIFERENTES um do outro com:
#   openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ====== CORS ======
# Origem(ns) do frontend em produção (sem barra final)
CORS_ORIGIN=https://seu-dominio.com

# ====== FRONTEND (variáveis públicas — nunca colocar segredos aqui) ======
# Tudo que o frontend usa deve ser prefixado com VITE_ (injetado em build-time)
VITE_API_URL=/api/v1

# ====== DOMÍNIO / SSL ======
# Usados na emissão e renovação do certificado Let's Encrypt (ver docs/SSL_LETSENCRYPT.md)
DOMAIN=seu-dominio.com
SSL_EMAIL=admin@seu-dominio.com
