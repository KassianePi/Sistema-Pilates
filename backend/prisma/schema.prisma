datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 🔐 MÓDULO AUTH — Autenticação e Perfis
// ============================================================================

enum FuncaoUsuario {
  ADMIN
  PROFESSOR
  RECEPCIONISTA
  FINANCEIRO
}

enum StatusUsuario {
  ATIVO
  INATIVO
  SUSPENSO
}

model Usuario {
  id             String        @id @default(uuid()) @db.VarChar(36)
  email          String        @unique @db.VarChar(255)
  senhaHash      String        @map("senha_hash") @db.VarChar(255)
  nomeCompleto   String        @map("nome_completo") @db.VarChar(255)
  telefone       String?       @db.VarChar(20)
  cpf            String        @unique @db.VarChar(11)
  funcao         FuncaoUsuario @default(RECEPCIONISTA)
  status         StatusUsuario @default(ATIVO)
  ultimoAcessoEm DateTime?     @map("ultimo_acesso_em") @db.DateTime
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm   DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  aluno          Aluno?
  professor      Professor?
  pagamentos     Pagamento[]
  caixasAbertos  Caixa[]       @relation("CaixasAbertos")
  caixasFechados Caixa[]       @relation("CaixasFechados")
  notificacoes   Notificacao[]
  logs           LogAuditoria[]

  @@index([email])
  @@index([cpf])
  @@index([status])
  @@index([funcao])
  @@map("usuarios")
}

// ============================================================================
// 👨‍🎓 MÓDULO ALUNOS — Gestão de Alunos e Planos
// ============================================================================

enum Genero {
  M
  F
  OUTRO
}

model Aluno {
  id                        String             @id @default(uuid()) @db.VarChar(36)
  usuarioId                 String             @unique @map("usuario_id") @db.VarChar(36)
  dataNascimento            DateTime?          @map("data_nascimento") @db.Date
  genero                    Genero?
  endereco                  String?            @db.VarChar(255)
  cidade                    String?            @db.VarChar(100)
  estado                    String?            @db.VarChar(2)
  cep                       String?            @db.VarChar(10)
  contatoEmergenciaNome     String?            @map("contato_emergencia_nome") @db.VarChar(255)
  contatoEmergenciaTelefone String?            @map("contato_emergencia_telefone") @db.VarChar(20)
  restricoesMedicas         String?            @map("restricoes_medicas") @db.Text
  ativo                     Boolean            @default(true)
  criadoEm                  DateTime           @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm              DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  usuario                   Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planos                    PlanoAluno[]
  progressos                ProgressoAluno[]
  presencas                 Presenca[]
  mensalidades              Mensalidade[]

  @@index([ativo])
  @@map("alunos")
}

enum TipoPlano {
  BASICO_4
  BASICO_8
  PREMIUM
  CUSTOMIZADO
}

enum StatusPlano {
  ATIVO
  PAUSADO
  CONCLUIDO
}

model PlanoAluno {
  id             String      @id @default(uuid()) @db.VarChar(36)
  alunoId        String      @map("aluno_id") @db.VarChar(36)
  tipoPlano      TipoPlano   @map("tipo_plano")
  dataInicio     DateTime    @map("data_inicio") @db.Date
  dataFim        DateTime?   @map("data_fim") @db.Date
  custoMensal    Decimal     @map("custo_mensal") @db.Decimal(10, 2)
  aulasPorSemana Int?        @map("aulas_por_semana")
  status         StatusPlano @default(ATIVO)
  observacoes    String?     @db.Text
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm   DateTime    @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  aluno          Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([status])
  @@index([dataInicio])
  @@index([dataFim])
  @@map("planos_alunos")
}

model ProgressoAluno {
  id                String   @id @default(uuid()) @db.VarChar(36)
  alunoId           String   @map("aluno_id") @db.VarChar(36)
  aulaId            String   @map("aula_id") @db.VarChar(36)
  dataAvaliacao     DateTime @map("data_avaliacao") @db.Date
  notaFlexibilidade Int?     @map("nota_flexibilidade")
  notaForca         Int?     @map("nota_forca")
  notaEquilibrio    Int?     @map("nota_equilibrio")
  notaResistencia   Int?     @map("nota_resistencia")
  observacoes       String?  @db.Text
  criadoEm          DateTime @default(now()) @map("criado_em") @db.DateTime

  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula              Aula     @relation(fields: [aulaId], references: [id])

  @@index([alunoId])
  @@index([aulaId])
  @@index([dataAvaliacao])
  @@map("progresso_alunos")
}

// ============================================================================
// 👨‍🏫 MÓDULO PROFESSORES — Gestão de Professores
// ============================================================================

model Professor {
  id                String         @id @default(uuid()) @db.VarChar(36)
  usuarioId         String         @unique @map("usuario_id") @db.VarChar(36)
  especializacao    String?        @db.VarChar(255)
  numeroCertificado String?        @map("numero_certificado") @db.VarChar(50)
  taxaHoraria       Decimal?       @map("taxa_horaria") @db.Decimal(10, 2)
  biografia         String?        @db.Text
  ativo             Boolean        @default(true)
  criadoEm          DateTime       @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm      DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  usuario           Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  horarios          HorarioAula[]
  aulas             Aula[]

  @@index([ativo])
  @@map("professores")
}

// ============================================================================
// 📅 MÓDULO AGENDA — Aulas, Horários e Presenças
// ============================================================================

enum DiaSemana {
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
  DOM
}

enum StatusHorario {
  ATIVO
  ARQUIVADO
}

model HorarioAula {
  id           String        @id @default(uuid()) @db.VarChar(36)
  professorId  String        @map("professor_id") @db.VarChar(36)
  diaSemana    DiaSemana     @map("dia_semana")
  horaInicio   String        @map("hora_inicio") @db.VarChar(5)
  horaFim      String        @map("hora_fim") @db.VarChar(5)
  sala         String?       @db.VarChar(50)
  capacidade   Int           @default(15)
  status       StatusHorario @default(ATIVO)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  professor    Professor     @relation(fields: [professorId], references: [id], onDelete: Cascade)
  aulas        Aula[]

  @@index([professorId])
  @@index([diaSemana])
  @@index([status])
  @@map("horarios_aulas")
}

enum StatusAula {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Aula {
  id            String           @id @default(uuid()) @db.VarChar(36)
  horarioAulaId String           @map("horario_aula_id") @db.VarChar(36)
  professorId   String           @map("professor_id") @db.VarChar(36)
  dataAula      DateTime         @map("data_aula") @db.Date
  horaInicio    String           @map("hora_inicio") @db.VarChar(5)
  horaFim       String           @map("hora_fim") @db.VarChar(5)
  sala          String?          @db.VarChar(50)
  capacidade    Int              @default(15)
  status        StatusAula       @default(AGENDADA)
  observacoes   String?          @db.Text
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm  DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  horario       HorarioAula      @relation(fields: [horarioAulaId], references: [id])
  professor     Professor        @relation(fields: [professorId], references: [id])
  presencas     Presenca[]
  progressos    ProgressoAluno[]

  @@unique([horarioAulaId, dataAula], name: "uk_horario_aula_data")
  @@index([professorId])
  @@index([dataAula])
  @@index([status])
  @@map("aulas")
}

enum StatusPresenca {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

model Presenca {
  id           String         @id @default(uuid()) @db.VarChar(36)
  alunoId      String         @map("aluno_id") @db.VarChar(36)
  aulaId       String         @map("aula_id") @db.VarChar(36)
  status       StatusPresenca @default(AUSENTE)
  registradoEm DateTime?      @map("registrado_em") @db.DateTime
  observacoes  String?        @db.Text
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  aluno        Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula         Aula           @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId], name: "uk_aluno_aula")
  @@index([alunoId])
  @@index([aulaId])
  @@index([status])
  @@map("presencas")
}

// ============================================================================
// 💰 MÓDULO FINANCEIRO — Gestão Financeira
// ============================================================================

enum StatusMensalidade {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

model Mensalidade {
  id             String            @id @default(uuid()) @db.VarChar(36)
  alunoId        String            @map("aluno_id") @db.VarChar(36)
  mes            Int               @db.TinyInt
  ano            Int
  valor          Decimal           @db.Decimal(10, 2)
  status         StatusMensalidade @default(PENDENTE)
  dataVencimento DateTime          @map("data_vencimento") @db.Date
  dataPagamento  DateTime?         @map("data_pagamento") @db.Date
  observacoes    String?           @db.Text
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.DateTime
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em") @db.DateTime

  aluno          Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  pagamentos     Pagamento[]

  @@unique([alunoId, mes, ano], name: "uk_aluno_mes_ano")
  @@index([alunoId])
  @@index([status])
  @@index([dataVencimento])
  @@index([ano, mes])
  @@map("mensalidades")
}

enum MetodoPagamento {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA_BANCARIA
}

model Pagamento {
  id                   String          @id @default(uuid()) @db.VarChar(36)
  mensalidadeId        String          @map("mensalidade_id") @db.VarChar(36)
  valor                Decimal         @db.Decimal(10, 2)
  metodoPagamento      MetodoPagamento @map("metodo_pagamento")
  referencia           String?         @db.VarChar(255)
  pagoEm               DateTime        @default(now()) @map("pago_em") @db.DateTime
  recebidoPorUsuarioId String          @map("recebido_por_usuario_id") @db.VarChar(36)
  observacoes          String?         @db.Text
  criadoEm             DateTime        @default(now()) @map("criado_em") @db.DateTime

  mensalidade          Mensalidade     @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  recebidoPor          Usuario         @relation(fields: [recebidoPorUsuarioId], references: [id])

  @@index([mensalidadeId])
  @@index([pagoEm])
  @@index([recebidoPorUsuarioId])
  @@map("pagamentos")
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

model Caixa {
  id                  String      @id @default(uuid()) @db.VarChar(36)
  dataAbertura        DateTime    @unique @map("data_abertura") @db.Date
  saldoAbertura       Decimal     @default(0) @map("saldo_abertura") @db.Decimal(15, 2)
  totalEntrada        Decimal     @default(0) @map("total_entrada") @db.Decimal(15, 2)
  totalSaida          Decimal     @default(0) @map("total_saida") @db.Decimal(15, 2)
  saldoFechamento     Decimal?    @map("saldo_fechamento") @db.Decimal(15, 2)
  abertoPorUsuarioId  String      @map("aberto_por_usuario_id") @db.VarChar(36)
  fechadoPorUsuarioId String?     @map("fechado_por_usuario_id") @db.VarChar(36)
  abertoEm            DateTime    @default(now()) @map("aberto_em") @db.DateTime
  fechadoEm           DateTime?   @map("fechado_em") @db.DateTime
  status              StatusCaixa @default(ABERTO)
  observacoes         String?     @db.Text
  criadoEm            DateTime    @default(now()) @map("criado_em") @db.DateTime

  abertoPor           Usuario     @relation("CaixasAbertos", fields: [abertoPorUsuarioId], references: [id])
  fechadoPor          Usuario?    @relation("CaixasFechados", fields: [fechadoPorUsuarioId], references: [id])

  @@index([dataAbertura])
  @@index([status])
  @@index([abertoPorUsuarioId])
  @@index([fechadoPorUsuarioId])
  @@map("caixa")
}

// ============================================================================
// 🔔 MÓDULO NOTIFICAÇÕES
// ============================================================================

enum TipoNotificacao {
  AULA_CANCELADA
  MENSALIDADE_VENCIDA
  BOAS_VINDAS
  SISTEMA
}

model Notificacao {
  id                    String          @id @default(uuid()) @db.VarChar(36)
  usuarioDestinatarioId String          @map("usuario_destinatario_id") @db.VarChar(36)
  tipo                  TipoNotificacao
  assunto               String          @db.VarChar(255)
  mensagem              String          @db.Text
  lidoEm                DateTime?       @map("lido_em") @db.DateTime
  criadoEm              DateTime        @default(now()) @map("criado_em") @db.DateTime

  destinatario          Usuario         @relation(fields: [usuarioDestinatarioId], references: [id], onDelete: Cascade)

  @@index([usuarioDestinatarioId])
  @@index([criadoEm])
  @@index([lidoEm])
  @@map("notificacoes")
}

// ============================================================================
// 📊 MÓDULO AUDITORIA
// ============================================================================

enum AcaoAuditoria {
  CRIAR
  ATUALIZAR
  DELETAR
  LER
}

model LogAuditoria {
  id           String        @id @default(uuid()) @db.VarChar(36)
  usuarioId    String        @map("usuario_id") @db.VarChar(36)
  tipoEntidade String        @map("tipo_entidade") @db.VarChar(100)
  idEntidade   String?       @map("id_entidade") @db.VarChar(36)
  acao         AcaoAuditoria
  valoresAntigos Json?       @map("valores_antigos")
  valoresNovos   Json?       @map("valores_novos")
  enderecoIp   String?       @map("endereco_ip") @db.VarChar(45)
  userAgent    String?       @map("user_agent") @db.VarChar(255)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.DateTime

  usuario      Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tipoEntidade, idEntidade])
  @@index([criadoEm])
  @@map("logs_auditoria")
}
