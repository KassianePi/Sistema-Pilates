// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ============================================================================
// 🔐 MÓDULO AUTH — Autenticação e Perfis
// ============================================================================

enum FuncaoUsuario {
  ADMIN
  PROFESSOR
  RECEPCIONISTA
  FINANCEIRO
  ALUNO
}

enum StatusUsuario {
  ATIVO
  INATIVO
  SUSPENSO
}

model Usuario {
  id             String        @id @default(uuid()) @db.VarChar(36)
  email          String        @unique @db.VarChar(255)
  senhaHash      String        @map("senha_hash") @db.VarChar(255)
  nomeCompleto   String        @map("nome_completo") @db.VarChar(255)
  telefone       String?       @db.VarChar(20)
  cpf            String        @unique @db.VarChar(11)
  funcao         FuncaoUsuario @default(RECEPCIONISTA)
  status         StatusUsuario @default(ATIVO)
  ultimoAcessoEm DateTime?     @map("ultimo_acesso_em")
  criadoEm       DateTime      @default(now()) @map("criado_em")
  atualizadoEm   DateTime      @default(now()) @updatedAt @map("atualizado_em")

  aluno                   Aluno?
  professor               Professor?
  pagamentos              Pagamento[]
  caixasAbertos           Caixa[]       @relation("CaixasAbertos")
  caixasFechados          Caixa[]       @relation("CaixasFechados")
  notificacoes            Notificacao[]
  logs                    LogAuditoria[]
  estornosAprovados       Estorno[]     @relation("EstornoAprovador")
  comprovantesAnalisados  ComprovantePagemento[] @relation("ComprovantesAnalisados")
  aulasAlteradas          Aula[]        @relation("AulaAlteradaPor")
  termosCriados           TermoUso[]    @relation("TermosCriados")
  avaliacoesRegistradas   AvaliacaoCorporal[]
  evolucoesRegistradas    EvolucaoAula[]
  execucoesGeracaoMensalidades ExecucaoJobMensalidades[] @relation("ExecucoesGeracaoMensalidades")

  @@index([email])
  @@index([cpf])
  @@index([status])
  @@map("usuarios")
}

// ============================================================================
// 👥 MÓDULO ALUNOS — Gerenciamento de Alunos
// ============================================================================

enum StatusAluno {
  ATIVO
  INATIVO
  SUSPENSO
  FORMADO
}

model Aluno {
  id              String       @id @default(uuid()) @db.VarChar(36)
  usuarioId       String       @unique @db.VarChar(36)
  planoId         String?      @db.VarChar(36) @map("plano_id")
  dataInicio      DateTime     @map("data_inicio")
  // Dia do mês (1-31) usado para calcular o vencimento das próximas mensalidades
  // geradas automaticamente. Fonte única de verdade — a geração nunca deriva o
  // vencimento somando meses à última mensalidade.
  diaVencimento   Int          @default(10) @map("dia_vencimento")
  dataNascimento  DateTime?    @map("data_nascimento")
  ultimoAcesso    DateTime?    @map("ultimo_acesso")
  endereco        String?      @db.VarChar(255)
  cidade          String?      @db.VarChar(100)
  estado          String?      @db.VarChar(2)
  cep             String?      @db.VarChar(9)
  observacoes     String?      @db.LongText
  status          StatusAluno  @default(ATIVO)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @default(now()) @updatedAt @map("atualizado_em")

  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planoAtual      Plano?        @relation("PlanoAtualAluno", fields: [planoId], references: [id])
  presencas       Presenca[]
  inscricoes      InscricaoAula[]
  mensalidades    Mensalidade[]
  reposicoes      Reposicao[]
  estornos        Estorno[]
  comprovantes    ComprovantePagemento[]
  termosAceites   TermoAceite[]
  avaliacoes      AvaliacaoCorporal[]
  evolucoes       EvolucaoAula[]

  @@index([usuarioId])
  @@index([status])
  @@index([planoId])
  @@map("alunos")
}

// ============================================================================
// 🎓 MÓDULO PROFESSORES — Gerenciamento de Professores
// ============================================================================

enum StatusProfessor {
  ATIVO
  INATIVO
  LICENCA
}

model Professor {
  id              String         @id @default(uuid()) @db.VarChar(36)
  usuarioId       String         @unique @db.VarChar(36)
  especialidade   String?        @db.VarChar(255)
  bio             String?        @db.LongText
  status          StatusProfessor @default(ATIVO)
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @default(now()) @updatedAt @map("atualizado_em")

  usuario         Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aulas           Aula[]
  relatorios      Relatorio[]

  @@index([usuarioId])
  @@index([status])
  @@map("professores")
}

// ============================================================================
// 💰 MÓDULO PLANOS — Planos de Pilates
// ============================================================================

enum TipoPlano {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

model Plano {
  id              String      @id @default(uuid()) @db.VarChar(36)
  nome            String      @unique @db.VarChar(255)
  descricao       String?     @db.LongText
  tipo            TipoPlano   @default(MENSAL)
  aulas           Int         @default(4)
  preco           Decimal     @db.Decimal(10, 2)
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @default(now()) @updatedAt @map("atualizado_em")

  mensalidades    Mensalidade[]
  alunosAtivos    Aluno[]      @relation("PlanoAtualAluno")

  @@index([ativo])
  @@map("planos")
}

// ============================================================================
// 📅 MÓDULO AGENDA — Aulas e Presença
// ============================================================================

enum StatusAula {
  AGENDADA
  REALIZADA
  CANCELADA
  ADIADA
  SUSPENSA
  EXCLUIDA
}

enum TipoAula {
  INDIVIDUAL
  DUPLA
  GRUPO
}

enum CategoriaAula {
  GERAL
  SOB_DEMANDA
}

model Modalidade {
  id           String   @id @default(uuid()) @db.VarChar(36)
  nome         String   @unique @db.VarChar(100)
  descricao    String?  @db.VarChar(255)
  valor        Decimal? @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  aulas        Aula[]

  @@index([ativo])
  @@map("modalidades")
}

model Aula {
  id              String     @id @default(uuid()) @db.VarChar(36)
  professorId     String     @db.VarChar(36)
  modalidadeId    String?    @db.VarChar(36) @map("modalidade_id")
  dataHoraInicio  DateTime   @map("data_hora_inicio")
  duracao         Int        @default(50)
  capacidade      Int        @default(10)
  sala            String        @db.VarChar(100)
  tipo            TipoAula      @default(GRUPO)
  categoria       CategoriaAula @default(GERAL)
  observacoes     String?       @db.LongText
  status          StatusAula    @default(AGENDADA)
  justificativa      String?    @db.LongText
  statusAlteradoEm   DateTime?  @map("status_alterado_em")
  statusAlteradoPorId String?   @db.VarChar(36) @map("status_alterado_por_id")
  dataHoraAnterior   DateTime?  @map("data_hora_anterior")
  criadoEm        DateTime   @default(now()) @map("criado_em")
  atualizadoEm    DateTime   @default(now()) @updatedAt @map("atualizado_em")

  professor        Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  modalidade       Modalidade? @relation(fields: [modalidadeId], references: [id], onDelete: SetNull)
  statusAlteradoPor Usuario?   @relation("AulaAlteradaPor", fields: [statusAlteradoPorId], references: [id], onDelete: SetNull)
  presencas        Presenca[]
  inscricoes       InscricaoAula[]
  reposicoesOrigem Reposicao[] @relation("AulaOriginal")
  reposicoesAlvo   Reposicao[] @relation("ReposicaoAula")
  evolucoes        EvolucaoAula[]

  @@index([professorId])
  @@index([modalidadeId])
  @@index([dataHoraInicio])
  @@index([status])
  @@index([categoria])
  @@index([statusAlteradoPorId])
  @@map("aulas")
}

// ============================================================================
// 📍 MÓDULO PRESENÇA — Controle de Presença
// ============================================================================

enum StatusPresenca {
  PRESENTE
  AUSENTE
  FALTA_JUSTIFICADA
}

model Presenca {
  id              String         @id @default(uuid()) @db.VarChar(36)
  alunoId         String         @db.VarChar(36)
  aulaId          String         @db.VarChar(36)
  status          StatusPresenca @default(PRESENTE)
  dataRegistro    DateTime       @map("data_registro")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula            Aula           @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId])
  @@index([alunoId])
  @@index([aulaId])
  @@map("presencas")
}

// ============================================================================
// 📝 MÓDULO MATRÍCULA — Inscrição de alunos em aulas
// ============================================================================

enum StatusInscricao {
  ATIVA
  CANCELADA
}

model InscricaoAula {
  id           String          @id @default(uuid()) @db.VarChar(36)
  alunoId      String          @db.VarChar(36)
  aulaId       String          @db.VarChar(36)
  status       StatusInscricao @default(ATIVA)
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @default(now()) @updatedAt @map("atualizado_em")

  aluno        Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula         Aula            @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId])
  @@index([aulaId])
  @@index([alunoId])
  @@index([status])
  @@map("inscricoes_aula")
}

// ============================================================================
// 🔄 MÓDULO REPOSIÇÃO — Controle de Reposições
// ============================================================================

enum StatusReposicao {
  PENDENTE
  AGENDADA
  REALIZADA
  CANCELADA
}

model Reposicao {
  id              String            @id @default(uuid()) @db.VarChar(36)
  alunoId         String            @db.VarChar(36)
  aulaOriginalId  String            @db.VarChar(36)
  aulaReposicaoId String?           @db.VarChar(36)
  motivo          String            @db.VarChar(255)
  status          StatusReposicao   @default(PENDENTE)
  dataSolicitacao DateTime          @map("data_solicitacao")
  criadoEm        DateTime          @default(now()) @map("criado_em")
  atualizadoEm    DateTime          @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aulaOriginal    Aula              @relation("AulaOriginal", fields: [aulaOriginalId], references: [id], onDelete: Cascade)
  aulaReposicao   Aula?             @relation("ReposicaoAula", fields: [aulaReposicaoId], references: [id], onDelete: SetNull)

  @@index([alunoId])
  @@index([aulaOriginalId])
  @@index([status])
  @@map("reposicoes")
}

// ============================================================================
// 💳 MÓDULO FINANCEIRO — Caixa e Movimentação
// ============================================================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  CHEQUE
  TRANSFERENCIA
}

model Caixa {
  id                String              @id @default(uuid()) @db.VarChar(36)
  usuarioAbreId     String              @db.VarChar(36)
  usuarioFechaId    String?             @db.VarChar(36)
  dataAbertura      DateTime            @map("data_abertura")
  dataFechamento    DateTime?           @map("data_fechamento")
  saldoAbertura     Decimal             @map("saldo_abertura") @db.Decimal(10, 2)
  saldoFechamento   Decimal?            @map("saldo_fechamento") @db.Decimal(10, 2)
  observacoes       String?             @db.LongText
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @default(now()) @updatedAt @map("atualizado_em")

  usuarioAbre       Usuario             @relation("CaixasAbertos", fields: [usuarioAbreId], references: [id])
  usuarioFecha      Usuario?            @relation("CaixasFechados", fields: [usuarioFechaId], references: [id])
  pagamentos        Pagamento[]

  @@index([usuarioAbreId])
  @@index([dataAbertura])
  @@map("caixas")
}

// ============================================================================
// 💰 MÓDULO MENSALIDADES — Mensalidades e Pagamentos
// ============================================================================

enum StatusMensalidade {
  PENDENTE
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoMensalidade {
  MENSAL
  AVULSO
}

model Mensalidade {
  id              String             @id @default(uuid()) @db.VarChar(36)
  alunoId         String             @db.VarChar(36)
  planoId         String?            @db.VarChar(36)
  tipo            TipoMensalidade    @default(MENSAL)
  mesReferencia   DateTime           @map("mes_referencia")
  dataVencimento  DateTime           @map("data_vencimento")
  valor           Decimal            @db.Decimal(10, 2)
  desconto        Decimal            @default(0) @db.Decimal(10, 2)
  status          StatusMensalidade  @default(PENDENTE)
  observacoes     String?            @db.LongText
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  plano           Plano?             @relation(fields: [planoId], references: [id])
  pagamentos      Pagamento[]
  estornos        Estorno[]
  comprovantes    ComprovantePagemento[]
  cobrancasPix    CobrancaPix[]

  // Idempotência da geração automática: nunca duas mensalidades do mesmo
  // aluno/competência/tipo. mesReferencia de tipo=MENSAL é sempre normalizada
  // para o 1º dia do mês (ver FinanceiroService.criarMensalidade e
  // MensalidadesAutomaticasService) para essa constraint funcionar de verdade.
  @@unique([alunoId, mesReferencia, tipo])
  @@index([alunoId])
  @@index([status])
  @@index([tipo])
  @@index([dataVencimento])
  @@map("mensalidades")
}

// ============================================================================
// 💳 MÓDULO PAGAMENTOS — Registro de Pagamentos
// ============================================================================

model Pagamento {
  id              String              @id @default(uuid()) @db.VarChar(36)
  mensalidadeId   String              @db.VarChar(36)
  caixaId         String?             @db.VarChar(36)
  usuarioId       String              @db.VarChar(36)
  dataPagamento   DateTime            @map("data_pagamento")
  valor           Decimal             @db.Decimal(10, 2)
  metodo          MetodoPagamento     @default(PIX)
  referencia      String?             @db.VarChar(255)
  observacoes     String?             @db.LongText
  criadoEm        DateTime            @default(now()) @map("criado_em")

  mensalidade     Mensalidade         @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  caixa           Caixa?              @relation(fields: [caixaId], references: [id])
  usuario         Usuario             @relation(fields: [usuarioId], references: [id])

  @@index([mensalidadeId])
  @@index([caixaId])
  @@index([dataPagamento])
  @@map("pagamentos")
}

// ============================================================================
// 🔁 MÓDULO PAGAMENTOS PIX — Cobrança PIX automatizada (Mercado Pago)
// ============================================================================

enum StatusCobrancaPix {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
  EXPIRADO
}

model CobrancaPix {
  id                String            @id @default(uuid()) @db.VarChar(36)
  mensalidadeId     String            @db.VarChar(36) @map("mensalidade_id")
  gateway           String            @default("MERCADO_PAGO") @db.VarChar(30)
  externalPaymentId String?           @unique @db.VarChar(50) @map("external_payment_id")
  externalReference String            @db.VarChar(36) @map("external_reference")
  status            StatusCobrancaPix @default(PENDENTE)
  statusDetail      String?           @db.VarChar(100) @map("status_detail")
  valor             Decimal           @db.Decimal(10, 2)
  qrCode            String?           @db.LongText @map("qr_code")
  qrCodeBase64      String?           @db.LongText @map("qr_code_base64")
  ticketUrl         String?           @db.VarChar(500) @map("ticket_url")
  dataExpiracao     DateTime?         @map("data_expiracao")
  dataAprovacao     DateTime?         @map("data_aprovacao")
  criadoEm          DateTime          @default(now()) @map("criado_em")
  atualizadoEm      DateTime          @default(now()) @updatedAt @map("atualizado_em")

  mensalidade       Mensalidade          @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  eventosWebhook    WebhookMercadoPago[]

  @@index([mensalidadeId])
  @@index([status])
  @@map("cobrancas_pix")
}

model WebhookMercadoPago {
  id                   String       @id @default(uuid()) @db.VarChar(36)
  cobrancaPixId        String?      @db.VarChar(36) @map("cobranca_pix_id")
  externalEventId      String       @unique @db.VarChar(100) @map("external_event_id")
  topico               String       @db.VarChar(30)
  paymentIdMp          String?      @db.VarChar(50) @map("payment_id_mp")
  payload              Json
  processadoComSucesso Boolean      @default(false) @map("processado_com_sucesso")
  erro                 String?      @db.LongText
  recebidoEm           DateTime     @default(now()) @map("recebido_em")

  cobrancaPix          CobrancaPix? @relation(fields: [cobrancaPixId], references: [id])

  @@index([cobrancaPixId])
  @@map("webhooks_mercado_pago")
}

// ============================================================================
// 🔁 MÓDULO MENSALIDADES AUTOMÁTICAS — Geração automática + lock + histórico
// ============================================================================

enum OrigemExecucaoJob {
  CRON
  MANUAL
}

enum StatusExecucaoJob {
  EM_ANDAMENTO
  SUCESSO
  PARCIAL
  ERRO
}

// Lock de execução única: impede duas execuções (cron + manual, ou duas
// réplicas do backend) processarem a lista de alunos ao mesmo tempo. Não usa
// GET_LOCK() do MySQL porque locks nomeados são presos à conexão que os
// obteve, e o Prisma usa um pool — nada garante que RELEASE_LOCK rode na
// mesma conexão do GET_LOCK. Uma tabela com lease/expiração evita esse
// problema e funciona normalmente com o pool de conexões.
model JobLock {
  chave     String            @id @db.VarChar(100)
  travadoEm DateTime          @map("travado_em")
  expiraEm  DateTime          @map("expira_em")
  origem    OrigemExecucaoJob

  @@map("job_locks")
}

// Histórico persistido de cada execução real (dry-run nunca grava aqui — ver
// MensalidadesAutomaticasService). Preparado para um card de status no
// Dashboard Administrativo (🟢 SUCESSO / 🟡 PARCIAL / 🔴 ERRO) sem precisar
// interpretar logs.
model ExecucaoJobMensalidades {
  id                   String            @id @default(uuid()) @db.VarChar(36)
  origem               OrigemExecucaoJob
  status               StatusExecucaoJob @default(EM_ANDAMENTO)
  dryRun               Boolean           @default(false) @map("dry_run")
  executadoPorId       String?           @db.VarChar(36) @map("executado_por_id")
  iniciadoEm           DateTime          @map("iniciado_em")
  finalizadoEm         DateTime?         @map("finalizado_em")
  duracaoMs            Int?              @map("duracao_ms")
  totalAlunosElegiveis Int               @default(0) @map("total_alunos_elegiveis")
  alunosAnalisados     Int               @default(0) @map("alunos_analisados")
  mensalidadesCriadas  Int               @default(0) @map("mensalidades_criadas")
  alunosIgnorados      Int               @default(0) @map("alunos_ignorados")
  detalhesIgnorados    Json              @map("detalhes_ignorados")
  erros                Json
  criadoEm             DateTime          @default(now()) @map("criado_em")

  executadoPor         Usuario?          @relation("ExecucoesGeracaoMensalidades", fields: [executadoPorId], references: [id], onDelete: SetNull)

  @@index([iniciadoEm])
  @@index([status])
  @@map("execucoes_job_mensalidades")
}

// ============================================================================
// 📊 MÓDULO RELATÓRIOS — Geração de Relatórios
// ============================================================================

enum TipoRelatorio {
  FREQUENCIA
  FINANCEIRO
  PRESENCA_ALUNO
  RECEITA_MENSAL
  PENDENCIAS_PAGAMENTO
}

model Relatorio {
  id              String        @id @default(uuid()) @db.VarChar(36)
  professorId     String        @db.VarChar(36)
  tipo            TipoRelatorio
  titulo          String        @db.VarChar(255)
  descricao       String?       @db.LongText
  dataPeriodoInicio DateTime    @map("data_periodo_inicio")
  dataPeriodoFim  DateTime      @map("data_periodo_fim")
  conteudo        String        @db.LongText
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @default(now()) @updatedAt @map("atualizado_em")

  professor       Professor     @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([tipo])
  @@map("relatorios")
}

// ============================================================================
// 🔔 MÓDULO NOTIFICAÇÕES — Notificações do Sistema
// ============================================================================

enum TipoNotificacao {
  AULA_AGENDADA
  PAGAMENTO_VENCIDO
  PAGAMENTO_CONFIRMADO
  MENSALIDADE_CRIADA
  ESTORNO_ATUALIZADO
  PRESENCA_REGISTRADA
  REPOSICAO_OFERECIDA
  MENSAGEM_ADMIN
}

enum StatusNotificacao {
  NAO_LIDA
  LIDA
  ARQUIVADA
}

model Notificacao {
  id              String              @id @default(uuid()) @db.VarChar(36)
  usuarioId       String              @db.VarChar(36)
  tipo            TipoNotificacao
  titulo          String              @db.VarChar(255)
  mensagem        String              @db.LongText
  status          StatusNotificacao   @default(NAO_LIDA)
  dataLeitura     DateTime?           @map("data_leitura")
  criadoEm        DateTime            @default(now()) @map("criado_em")

  usuario         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([status])
  @@map("notificacoes")
}

// ============================================================================
// 🔐 MÓDULO AUDITORIA — Logs de Auditoria
// ============================================================================

enum TipoAcao {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model LogAuditoria {
  id              String        @id @default(uuid()) @db.VarChar(36)
  usuarioId       String        @db.VarChar(36)
  acao            TipoAcao
  entidade        String        @db.VarChar(255)
  entidadeId      String        @db.VarChar(36)
  dadosAntigos    String?       @map("dados_antigos") @db.LongText
  dadosNovos      String?       @map("dados_novos") @db.LongText
  enderecoIp      String?       @map("endereco_ip") @db.VarChar(45)
  userAgent       String?       @map("user_agent") @db.LongText
  criadoEm        DateTime      @default(now()) @map("criado_em")

  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([acao])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

// ============================================================================
// 📎 MÓDULO COMPROVANTES — Comprovantes de Pagamento
// ============================================================================

enum StatusComprovante {
  PENDENTE
  APROVADO
  REJEITADO
}

model ComprovantePagemento {
  id             String            @id @default(uuid()) @db.VarChar(36)
  mensalidadeId  String            @db.VarChar(36) @map("mensalidade_id")
  alunoId        String            @db.VarChar(36) @map("aluno_id")
  arquivo        String            @db.LongText
  nomeArquivo    String            @db.VarChar(255) @map("nome_arquivo")
  tipoArquivo    String            @db.VarChar(50)  @map("tipo_arquivo")
  dataEnvio      DateTime          @map("data_envio")
  status         StatusComprovante @default(PENDENTE)
  observacoes    String?           @db.LongText
  analisadoPorId String?           @db.VarChar(36) @map("analisado_por_id")
  criadoEm       DateTime          @default(now()) @map("criado_em")
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em")

  mensalidade    Mensalidade @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  aluno          Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  analisadoPor   Usuario?    @relation("ComprovantesAnalisados", fields: [analisadoPorId], references: [id])

  @@index([mensalidadeId])
  @@index([alunoId])
  @@index([status])
  @@map("comprovantes_pagamento")
}

// ============================================================================
// ⚙️ MÓDULO CONFIGURAÇÃO — Dados do Studio
// ============================================================================

model ConfiguracaoStudio {
  id                String   @id @default("studio")
  chavePix          String?  @db.VarChar(255) @map("chave_pix")
  tipoChavePix      String?  @db.VarChar(20)  @map("tipo_chave_pix")
  nomeRecebedor     String?  @db.VarChar(255) @map("nome_recebedor")
  qrCodeBase64      String?  @db.LongText     @map("qr_code_base64")
  // Liga/desliga o fluxo automático de PIX (Mercado Pago) no portal do aluno,
  // sem depender de deploy — se desligado, volta a mostrar o fluxo manual
  // (chave PIX estática + upload de comprovante).
  usarPixAutomatico Boolean  @default(true)   @map("usar_pix_automatico")
  // Geração automática de mensalidades — ver módulo mensalidades-automaticas.
  // cronGeracaoMensalidades é lida só no boot do processo (ver job); mudar o
  // valor exige restart do backend para valer.
  geracaoAutomaticaAtiva    Boolean  @default(true)   @map("geracao_automatica_ativa")
  diasAntesGeracao          Int      @default(5)      @map("dias_antes_geracao")
  maximoMensalidadesFuturas Int      @default(1)      @map("maximo_mensalidades_futuras")
  cronGeracaoMensalidades   String   @default("0 0,6,12,18 * * *") @db.VarChar(50) @map("cron_geracao_mensalidades")
  criadoEm          DateTime @default(now())  @map("criado_em")
  atualizadoEm      DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("configuracao_studio")
}

// ============================================================================
// 🔄 MÓDULO ESTORNOS — Solicitações de Reembolso Proporcional
// ============================================================================

enum StatusEstorno {
  SOLICITADO
  APROVADO
  PROCESSADO
  NEGADO
}

model Estorno {
  id               String        @id @default(uuid()) @db.VarChar(36)
  mensalidadeId    String        @db.VarChar(36) @map("mensalidade_id")
  alunoId          String        @db.VarChar(36) @map("aluno_id")
  diasContratados  Int           @map("dias_contratados")
  diasComparecidos Int           @map("dias_comparecidos")
  diasEstornados   Int           @map("dias_estornados")
  valorEstorno     Decimal       @db.Decimal(10, 2) @map("valor_estorno")
  motivo           String?       @db.LongText
  status           StatusEstorno @default(SOLICITADO)
  aprovadoPorId    String?       @db.VarChar(36) @map("aprovado_por_id")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  mensalidade      Mensalidade   @relation(fields: [mensalidadeId], references: [id])
  aluno            Aluno         @relation(fields: [alunoId], references: [id])
  aprovadoPor      Usuario?      @relation("EstornoAprovador", fields: [aprovadoPorId], references: [id])

  @@index([mensalidadeId])
  @@index([alunoId])
  @@index([status])
  @@map("estornos")
}

// ============================================================================
// 📜 MÓDULO TERMOS — Termos de Uso e Prestação de Serviços
// ============================================================================

model TermoUso {
  id           String        @id @default(uuid()) @db.VarChar(36)
  versao       Int           @unique
  titulo       String        @db.VarChar(255)
  conteudo     String        @db.LongText
  publicado    Boolean       @default(false)
  publicadoEm  DateTime?     @map("publicado_em")
  criadoPorId  String?       @db.VarChar(36) @map("criado_por_id")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @default(now()) @updatedAt @map("atualizado_em")

  criadoPor    Usuario?      @relation("TermosCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)
  aceites      TermoAceite[]

  @@index([publicado])
  @@index([versao])
  @@map("termos_uso")
}

model TermoAceite {
  id          String   @id @default(uuid()) @db.VarChar(36)
  termoId     String   @db.VarChar(36) @map("termo_id")
  alunoId     String   @db.VarChar(36) @map("aluno_id")
  versao      Int
  aceitoEm    DateTime @default(now()) @map("aceito_em")
  enderecoIp  String?  @db.VarChar(45) @map("endereco_ip")
  userAgent   String?  @db.LongText    @map("user_agent")

  termo       TermoUso @relation(fields: [termoId], references: [id], onDelete: Cascade)
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([termoId, alunoId])
  @@index([termoId])
  @@index([alunoId])
  @@map("termos_aceites")
}

// ============================================================================
// 🩺 MÓDULO AVALIAÇÕES — Avaliação corporal do aluno
// ============================================================================

model AvaliacaoCorporal {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  alunoId            String   @db.VarChar(36) @map("aluno_id")
  registradoPorId    String   @db.VarChar(36) @map("registrado_por_id")
  dataAvaliacao      DateTime @map("data_avaliacao")
  peso               Decimal? @db.Decimal(5, 2)
  altura             Decimal? @db.Decimal(4, 2)
  medidas            Json?
  queixaPrincipal    String?  @db.VarChar(500) @map("queixa_principal")
  historicoMedico    String?  @db.LongText @map("historico_medico")
  observacoesPostura String?  @db.LongText @map("observacoes_postura")
  observacoesGerais  String?  @db.LongText @map("observacoes_gerais")
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @default(now()) @updatedAt @map("atualizado_em")

  aluno         Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  registradoPor Usuario         @relation(fields: [registradoPorId], references: [id])
  fotos         AvaliacaoFoto[]

  @@index([alunoId])
  @@index([dataAvaliacao])
  @@map("avaliacoes_corporais")
}

model AvaliacaoFoto {
  id          String   @id @default(uuid()) @db.VarChar(36)
  avaliacaoId String   @db.VarChar(36) @map("avaliacao_id")
  arquivo     String   @db.LongText
  tipoArquivo String   @db.VarChar(50) @map("tipo_arquivo")
  criadoEm    DateTime @default(now()) @map("criado_em")

  avaliacao AvaliacaoCorporal @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId])
  @@map("avaliacoes_fotos")
}

// ============================================================================
// 📈 MÓDULO EVOLUÇÃO — Evolução do aluno por aula
// ============================================================================

model EvolucaoAula {
  id              String   @id @default(uuid()) @db.VarChar(36)
  alunoId         String   @db.VarChar(36) @map("aluno_id")
  aulaId          String   @db.VarChar(36) @map("aula_id")
  registradoPorId String   @db.VarChar(36) @map("registrado_por_id")
  observacao      String   @db.LongText
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em")

  aluno         Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula          Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  registradoPor Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([alunoId])
  @@index([aulaId])
  @@map("evolucoes_aula")
}
