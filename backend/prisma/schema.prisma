// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ============================================================================
// 🔐 MÓDULO AUTH — Autenticação e Perfis
// ============================================================================

enum FuncaoUsuario {
  ADMIN
  PROFESSOR
  RECEPCIONISTA
  FINANCEIRO
  ALUNO
}

enum StatusUsuario {
  ATIVO
  INATIVO
  SUSPENSO
}

model Usuario {
  id             String        @id @default(uuid()) @db.VarChar(36)
  email          String        @unique @db.VarChar(255)
  senhaHash      String        @map("senha_hash") @db.VarChar(255)
  nomeCompleto   String        @map("nome_completo") @db.VarChar(255)
  telefone       String?       @db.VarChar(20)
  cpf            String        @unique @db.VarChar(11)
  funcao         FuncaoUsuario @default(RECEPCIONISTA)
  status         StatusUsuario @default(ATIVO)
  ultimoAcessoEm DateTime?     @map("ultimo_acesso_em")
  criadoEm       DateTime      @default(now()) @map("criado_em")
  atualizadoEm   DateTime      @default(now()) @updatedAt @map("atualizado_em")

  aluno                   Aluno?
  professor               Professor?
  pagamentos              Pagamento[]
  caixasAbertos           Caixa[]       @relation("CaixasAbertos")
  caixasFechados          Caixa[]       @relation("CaixasFechados")
  notificacoes            Notificacao[]
  logs                    LogAuditoria[]
  estornosAprovados       Estorno[]     @relation("EstornoAprovador")
  comprovantesAnalisados  ComprovantePagemento[] @relation("ComprovantesAnalisados")
  aulasAlteradas          Aula[]        @relation("AulaAlteradaPor")

  @@index([email])
  @@index([cpf])
  @@index([status])
  @@map("usuarios")
}

// ============================================================================
// 👥 MÓDULO ALUNOS — Gerenciamento de Alunos
// ============================================================================

enum StatusAluno {
  ATIVO
  INATIVO
  SUSPENSO
  FORMADO
}

model Aluno {
  id              String       @id @default(uuid()) @db.VarChar(36)
  usuarioId       String       @unique @db.VarChar(36)
  planoId         String?      @db.VarChar(36) @map("plano_id")
  dataInicio      DateTime     @map("data_inicio")
  dataNascimento  DateTime?    @map("data_nascimento")
  ultimoAcesso    DateTime?    @map("ultimo_acesso")
  endereco        String?      @db.VarChar(255)
  cidade          String?      @db.VarChar(100)
  estado          String?      @db.VarChar(2)
  cep             String?      @db.VarChar(9)
  observacoes     String?      @db.LongText
  status          StatusAluno  @default(ATIVO)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @default(now()) @updatedAt @map("atualizado_em")

  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planoAtual      Plano?        @relation("PlanoAtualAluno", fields: [planoId], references: [id])
  presencas       Presenca[]
  mensalidades    Mensalidade[]
  reposicoes      Reposicao[]
  estornos        Estorno[]
  comprovantes    ComprovantePagemento[]

  @@index([usuarioId])
  @@index([status])
  @@index([planoId])
  @@map("alunos")
}

// ============================================================================
// 🎓 MÓDULO PROFESSORES — Gerenciamento de Professores
// ============================================================================

enum StatusProfessor {
  ATIVO
  INATIVO
  LICENCA
}

model Professor {
  id              String         @id @default(uuid()) @db.VarChar(36)
  usuarioId       String         @unique @db.VarChar(36)
  especialidade   String?        @db.VarChar(255)
  bio             String?        @db.LongText
  status          StatusProfessor @default(ATIVO)
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @default(now()) @updatedAt @map("atualizado_em")

  usuario         Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aulas           Aula[]
  relatorios      Relatorio[]

  @@index([usuarioId])
  @@index([status])
  @@map("professores")
}

// ============================================================================
// 💰 MÓDULO PLANOS — Planos de Pilates
// ============================================================================

enum TipoPlano {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

model Plano {
  id              String      @id @default(uuid()) @db.VarChar(36)
  nome            String      @unique @db.VarChar(255)
  descricao       String?     @db.LongText
  tipo            TipoPlano   @default(MENSAL)
  aulas           Int         @default(4)
  preco           Decimal     @db.Decimal(10, 2)
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @default(now()) @updatedAt @map("atualizado_em")

  mensalidades    Mensalidade[]
  alunosAtivos    Aluno[]      @relation("PlanoAtualAluno")

  @@index([ativo])
  @@map("planos")
}

// ============================================================================
// 📅 MÓDULO AGENDA — Aulas e Presença
// ============================================================================

enum StatusAula {
  AGENDADA
  REALIZADA
  CANCELADA
  ADIADA
  SUSPENSA
  EXCLUIDA
}

enum TipoAula {
  INDIVIDUAL
  DUPLA
  GRUPO
}

enum CategoriaAula {
  GERAL
  SOB_DEMANDA
}

model Modalidade {
  id           String   @id @default(uuid()) @db.VarChar(36)
  nome         String   @unique @db.VarChar(100)
  descricao    String?  @db.VarChar(255)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  aulas        Aula[]

  @@index([ativo])
  @@map("modalidades")
}

model Aula {
  id              String     @id @default(uuid()) @db.VarChar(36)
  professorId     String     @db.VarChar(36)
  modalidadeId    String?    @db.VarChar(36) @map("modalidade_id")
  dataHoraInicio  DateTime   @map("data_hora_inicio")
  duracao         Int        @default(50)
  capacidade      Int        @default(10)
  sala            String        @db.VarChar(100)
  tipo            TipoAula      @default(GRUPO)
  categoria       CategoriaAula @default(GERAL)
  observacoes     String?       @db.LongText
  status          StatusAula    @default(AGENDADA)
  justificativa      String?    @db.LongText
  statusAlteradoEm   DateTime?  @map("status_alterado_em")
  statusAlteradoPorId String?   @db.VarChar(36) @map("status_alterado_por_id")
  dataHoraAnterior   DateTime?  @map("data_hora_anterior")
  criadoEm        DateTime   @default(now()) @map("criado_em")
  atualizadoEm    DateTime   @default(now()) @updatedAt @map("atualizado_em")

  professor        Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)
  modalidade       Modalidade? @relation(fields: [modalidadeId], references: [id], onDelete: SetNull)
  statusAlteradoPor Usuario?   @relation("AulaAlteradaPor", fields: [statusAlteradoPorId], references: [id], onDelete: SetNull)
  presencas        Presenca[]
  reposicoesOrigem Reposicao[] @relation("AulaOriginal")
  reposicoesAlvo   Reposicao[] @relation("ReposicaoAula")

  @@index([professorId])
  @@index([modalidadeId])
  @@index([dataHoraInicio])
  @@index([status])
  @@index([categoria])
  @@index([statusAlteradoPorId])
  @@map("aulas")
}

// ============================================================================
// 📍 MÓDULO PRESENÇA — Controle de Presença
// ============================================================================

enum StatusPresenca {
  PRESENTE
  AUSENTE
  FALTA_JUSTIFICADA
}

model Presenca {
  id              String         @id @default(uuid()) @db.VarChar(36)
  alunoId         String         @db.VarChar(36)
  aulaId          String         @db.VarChar(36)
  status          StatusPresenca @default(PRESENTE)
  dataRegistro    DateTime       @map("data_registro")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula            Aula           @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, aulaId])
  @@index([alunoId])
  @@index([aulaId])
  @@map("presencas")
}

// ============================================================================
// 🔄 MÓDULO REPOSIÇÃO — Controle de Reposições
// ============================================================================

enum StatusReposicao {
  PENDENTE
  AGENDADA
  REALIZADA
  CANCELADA
}

model Reposicao {
  id              String            @id @default(uuid()) @db.VarChar(36)
  alunoId         String            @db.VarChar(36)
  aulaOriginalId  String            @db.VarChar(36)
  aulaReposicaoId String?           @db.VarChar(36)
  motivo          String            @db.VarChar(255)
  status          StatusReposicao   @default(PENDENTE)
  dataSolicitacao DateTime          @map("data_solicitacao")
  criadoEm        DateTime          @default(now()) @map("criado_em")
  atualizadoEm    DateTime          @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aulaOriginal    Aula              @relation("AulaOriginal", fields: [aulaOriginalId], references: [id], onDelete: Cascade)
  aulaReposicao   Aula?             @relation("ReposicaoAula", fields: [aulaReposicaoId], references: [id], onDelete: SetNull)

  @@index([alunoId])
  @@index([aulaOriginalId])
  @@index([status])
  @@map("reposicoes")
}

// ============================================================================
// 💳 MÓDULO FINANCEIRO — Caixa e Movimentação
// ============================================================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  CHEQUE
  TRANSFERENCIA
}

model Caixa {
  id                String              @id @default(uuid()) @db.VarChar(36)
  usuarioAbreId     String              @db.VarChar(36)
  usuarioFechaId    String?             @db.VarChar(36)
  dataAbertura      DateTime            @map("data_abertura")
  dataFechamento    DateTime?           @map("data_fechamento")
  saldoAbertura     Decimal             @map("saldo_abertura") @db.Decimal(10, 2)
  saldoFechamento   Decimal?            @map("saldo_fechamento") @db.Decimal(10, 2)
  observacoes       String?             @db.LongText
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @default(now()) @updatedAt @map("atualizado_em")

  usuarioAbre       Usuario             @relation("CaixasAbertos", fields: [usuarioAbreId], references: [id])
  usuarioFecha      Usuario?            @relation("CaixasFechados", fields: [usuarioFechaId], references: [id])
  pagamentos        Pagamento[]

  @@index([usuarioAbreId])
  @@index([dataAbertura])
  @@map("caixas")
}

// ============================================================================
// 💰 MÓDULO MENSALIDADES — Mensalidades e Pagamentos
// ============================================================================

enum StatusMensalidade {
  PENDENTE
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoMensalidade {
  MENSAL
  AVULSO
}

model Mensalidade {
  id              String             @id @default(uuid()) @db.VarChar(36)
  alunoId         String             @db.VarChar(36)
  planoId         String?            @db.VarChar(36)
  tipo            TipoMensalidade    @default(MENSAL)
  mesReferencia   DateTime           @map("mes_referencia")
  dataVencimento  DateTime           @map("data_vencimento")
  valor           Decimal            @db.Decimal(10, 2)
  desconto        Decimal            @default(0) @db.Decimal(10, 2)
  status          StatusMensalidade  @default(PENDENTE)
  observacoes     String?            @db.LongText
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @default(now()) @updatedAt @map("atualizado_em")

  aluno           Aluno              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  plano           Plano?             @relation(fields: [planoId], references: [id])
  pagamentos      Pagamento[]
  estornos        Estorno[]
  comprovantes    ComprovantePagemento[]

  @@index([alunoId])
  @@index([status])
  @@index([tipo])
  @@index([dataVencimento])
  @@map("mensalidades")
}

// ============================================================================
// 💳 MÓDULO PAGAMENTOS — Registro de Pagamentos
// ============================================================================

model Pagamento {
  id              String              @id @default(uuid()) @db.VarChar(36)
  mensalidadeId   String              @db.VarChar(36)
  caixaId         String?             @db.VarChar(36)
  usuarioId       String              @db.VarChar(36)
  dataPagamento   DateTime            @map("data_pagamento")
  valor           Decimal             @db.Decimal(10, 2)
  metodo          MetodoPagamento     @default(PIX)
  referencia      String?             @db.VarChar(255)
  observacoes     String?             @db.LongText
  criadoEm        DateTime            @default(now()) @map("criado_em")

  mensalidade     Mensalidade         @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  caixa           Caixa?              @relation(fields: [caixaId], references: [id])
  usuario         Usuario             @relation(fields: [usuarioId], references: [id])

  @@index([mensalidadeId])
  @@index([caixaId])
  @@index([dataPagamento])
  @@map("pagamentos")
}

// ============================================================================
// 📊 MÓDULO RELATÓRIOS — Geração de Relatórios
// ============================================================================

enum TipoRelatorio {
  FREQUENCIA
  FINANCEIRO
  PRESENCA_ALUNO
  RECEITA_MENSAL
  PENDENCIAS_PAGAMENTO
}

model Relatorio {
  id              String        @id @default(uuid()) @db.VarChar(36)
  professorId     String        @db.VarChar(36)
  tipo            TipoRelatorio
  titulo          String        @db.VarChar(255)
  descricao       String?       @db.LongText
  dataPeriodoInicio DateTime    @map("data_periodo_inicio")
  dataPeriodoFim  DateTime      @map("data_periodo_fim")
  conteudo        String        @db.LongText
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @default(now()) @updatedAt @map("atualizado_em")

  professor       Professor     @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
  @@index([tipo])
  @@map("relatorios")
}

// ============================================================================
// 🔔 MÓDULO NOTIFICAÇÕES — Notificações do Sistema
// ============================================================================

enum TipoNotificacao {
  AULA_AGENDADA
  PAGAMENTO_VENCIDO
  PAGAMENTO_CONFIRMADO
  MENSALIDADE_CRIADA
  ESTORNO_ATUALIZADO
  PRESENCA_REGISTRADA
  REPOSICAO_OFERECIDA
  MENSAGEM_ADMIN
}

enum StatusNotificacao {
  NAO_LIDA
  LIDA
  ARQUIVADA
}

model Notificacao {
  id              String              @id @default(uuid()) @db.VarChar(36)
  usuarioId       String              @db.VarChar(36)
  tipo            TipoNotificacao
  titulo          String              @db.VarChar(255)
  mensagem        String              @db.LongText
  status          StatusNotificacao   @default(NAO_LIDA)
  dataLeitura     DateTime?           @map("data_leitura")
  criadoEm        DateTime            @default(now()) @map("criado_em")

  usuario         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([status])
  @@map("notificacoes")
}

// ============================================================================
// 🔐 MÓDULO AUDITORIA — Logs de Auditoria
// ============================================================================

enum TipoAcao {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model LogAuditoria {
  id              String        @id @default(uuid()) @db.VarChar(36)
  usuarioId       String        @db.VarChar(36)
  acao            TipoAcao
  entidade        String        @db.VarChar(255)
  entidadeId      String        @db.VarChar(36)
  dadosAntigos    String?       @map("dados_antigos") @db.LongText
  dadosNovos      String?       @map("dados_novos") @db.LongText
  enderecoIp      String?       @map("endereco_ip") @db.VarChar(45)
  userAgent       String?       @map("user_agent") @db.LongText
  criadoEm        DateTime      @default(now()) @map("criado_em")

  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([acao])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

// ============================================================================
// 📎 MÓDULO COMPROVANTES — Comprovantes de Pagamento
// ============================================================================

enum StatusComprovante {
  PENDENTE
  APROVADO
  REJEITADO
}

model ComprovantePagemento {
  id             String            @id @default(uuid()) @db.VarChar(36)
  mensalidadeId  String            @db.VarChar(36) @map("mensalidade_id")
  alunoId        String            @db.VarChar(36) @map("aluno_id")
  arquivo        String            @db.LongText
  nomeArquivo    String            @db.VarChar(255) @map("nome_arquivo")
  tipoArquivo    String            @db.VarChar(50)  @map("tipo_arquivo")
  dataEnvio      DateTime          @map("data_envio")
  status         StatusComprovante @default(PENDENTE)
  observacoes    String?           @db.LongText
  analisadoPorId String?           @db.VarChar(36) @map("analisado_por_id")
  criadoEm       DateTime          @default(now()) @map("criado_em")
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em")

  mensalidade    Mensalidade @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  aluno          Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  analisadoPor   Usuario?    @relation("ComprovantesAnalisados", fields: [analisadoPorId], references: [id])

  @@index([mensalidadeId])
  @@index([alunoId])
  @@index([status])
  @@map("comprovantes_pagamento")
}

// ============================================================================
// ⚙️ MÓDULO CONFIGURAÇÃO — Dados do Studio
// ============================================================================

model ConfiguracaoStudio {
  id            String   @id @default("studio")
  chavePix      String?  @db.VarChar(255) @map("chave_pix")
  tipoChavePix  String?  @db.VarChar(20)  @map("tipo_chave_pix")
  nomeRecebedor String?  @db.VarChar(255) @map("nome_recebedor")
  qrCodeBase64  String?  @db.LongText     @map("qr_code_base64")
  criadoEm      DateTime @default(now())  @map("criado_em")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("configuracao_studio")
}

// ============================================================================
// 🔄 MÓDULO ESTORNOS — Solicitações de Reembolso Proporcional
// ============================================================================

enum StatusEstorno {
  SOLICITADO
  APROVADO
  PROCESSADO
  NEGADO
}

model Estorno {
  id               String        @id @default(uuid()) @db.VarChar(36)
  mensalidadeId    String        @db.VarChar(36) @map("mensalidade_id")
  alunoId          String        @db.VarChar(36) @map("aluno_id")
  diasContratados  Int           @map("dias_contratados")
  diasComparecidos Int           @map("dias_comparecidos")
  diasEstornados   Int           @map("dias_estornados")
  valorEstorno     Decimal       @db.Decimal(10, 2) @map("valor_estorno")
  motivo           String?       @db.LongText
  status           StatusEstorno @default(SOLICITADO)
  aprovadoPorId    String?       @db.VarChar(36) @map("aprovado_por_id")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em")

  mensalidade      Mensalidade   @relation(fields: [mensalidadeId], references: [id])
  aluno            Aluno         @relation(fields: [alunoId], references: [id])
  aprovadoPor      Usuario?      @relation("EstornoAprovador", fields: [aprovadoPorId], references: [id])

  @@index([mensalidadeId])
  @@index([alunoId])
  @@index([status])
  @@map("estornos")
}
