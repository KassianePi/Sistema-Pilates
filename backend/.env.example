# ============================================================================
# ⚠️  IMPORTANTE: Este arquivo é um TEMPLATE
# Copie para .env e preencha com seus valores reais
# NUNCA committe o arquivo .env com senhas reais!
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================
# Formato: mysql://usuario:senha@host:porta/database
#
# Em Docker (desenvolvimento): mysql://pilates_user:pilates_pass@mysql:3306/pilates_db
# Em produção: mysql://user:senha_forte@prod-mysql.exemplo.com:3306/pilates_db
#
# Nota: Use 'mysql' como host quando dentro do Docker Compose
DATABASE_URL="mysql://pilates_user:pilates_pass@mysql:3306/pilates_db"

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Opções: development, production, test
NODE_ENV="development"

# ============================================================================
# JWT SECRETS
# ============================================================================
# ⚠️  GERAR SECRETS SEGUROS:
#
# Linux/Mac:
#   openssl rand -base64 32
#
# Windows (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
#
# Mínimo recomendado: 32 caracteres
# Em produção: use valores diferentes para cada chave
JWT_SECRET="gerar-com-openssl-rand--base64-32"
JWT_REFRESH_SECRET="gerar-com-openssl-rand--base64-32-diferente"

# ============================================================================
# SERVER
# ============================================================================
# PORT: Porta em que o servidor Fastify vai rodar
# HOST: Interface de rede (0.0.0.0 = todas as interfaces)
PORT="3000"
HOST="0.0.0.0"

# ============================================================================
# CORS
# ============================================================================
# URLs permitidas para requisições do frontend
# Separar múltiplas URLs com vírgula
# Desenvolvimento: http://localhost:3000,http://localhost:5173
# Produção: https://seu-dominio.com,https://app.seu-dominio.com
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ============================================================================
# LOGS
# ============================================================================
# LOG_LEVEL: Nível de verbosidade dos logs
# Opções: debug, info, warn, error
# Desenvolvimento: debug (mais detalhado)
# Produção: info
LOG_LEVEL="debug"

# ============================================================================
# INSTRUÇÕES DE SETUP
# ============================================================================
#
# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Preencha os valores:
#    - DATABASE_URL: confirme credenciais do MySQL
#    - JWT_SECRET e JWT_REFRESH_SECRET: gere novos secrets
#
# 3. Verifique conexão com o banco:
#    npx prisma db push
#
# 4. Inicie o servidor:
#    npm run dev
#
# 5. Teste health check:
#    curl http://localhost:3000/api/v1/health
#
# ============================================================================
