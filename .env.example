# ====== ENVIRONMENT ======
# Valores: development, production
NODE_ENV=development

# ====== MYSQL DATABASE ======
# Credenciais do banco de dados MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=pilates_user
MYSQL_PASSWORD=pilates_pass
MYSQL_DATABASE=pilates_db

# ====== JWT SECRETS ======
# Gerar secrets seguros com:
# openssl rand -base64 32
# ou em Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=seu_secret_super_seguro_aqui_32_caracteres_minimo_2024
JWT_REFRESH_SECRET=seu_refresh_secret_super_seguro_32_caracteres_2024

# ====== API CONFIGURATION ======
# Porta do backend Fastify
BACKEND_PORT=3000
# Porta do frontend Vite
FRONTEND_PORT=5173

# ====== FRONTEND VITE API URL ======
# URL da API que o frontend vai chamar
# Desenvolvimento: http://localhost:3000/api/v1
# Produção: https://seu-dominio.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# ====== MERCADO PAGO (cobrança PIX automatizada) ======
# Em desenvolvimento, use as credenciais de TESTE da sua conta sandbox
# (Suas integrações > aplicação > Credenciais de teste no painel do Mercado Pago).
MP_ACCESS_TOKEN=TEST-000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=gerar-no-painel-do-mercado-pago
# A URL do webhook é cadastrada no painel do Mercado Pago (Suas integrações >
# aplicação > Webhooks), não aqui — em dev, use a URL do seu túnel (ngrok/
# Cloudflare Tunnel) + /api/v1/webhooks/mercadopago.
