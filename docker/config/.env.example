# ============================================================================
# 🔐 VARIÁVEIS DE AMBIENTE — Sistema Studio de Pilates
# ============================================================================
# Copie este arquivo para .env e customize conforme necessário
#
# IMPORTANTE: Nunca commite o arquivo .env com valores reais!
# Sempre use .env.example como template
#
# ============================================================================

# --- DATABASE ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=pilates_db
MYSQL_USER=pilates_user
MYSQL_PASSWORD=pilates_pass
MYSQL_PORT=3306

# --- ADMINER (Interface Web) ---
ADMINER_PORT=8080
# Acesso: http://localhost:8080
# Server: mysql
# User: root ou pilates_user
# Password: conforme acima

# --- NODE.JS / BACKEND (Fase 2+) ---
NODE_ENV=development
DATABASE_URL=mysql://pilates_user:pilates_pass@mysql:3306/pilates_db

# JWT Secrets (MUDE PARA VALORES SEGUROS EM PRODUÇÃO!)
JWT_SECRET=dev-secret-mude-em-producao
JWT_REFRESH_SECRET=dev-refresh-secret-mude-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS e Segurança ---
CORS_ORIGIN=http://localhost:3000
API_PORT=3001

# --- LOGGING ---
LOG_LEVEL=debug
NODE_LOG_LEVEL=debug

# --- REDIS (Futuro) ---
REDIS_URL=redis://redis:6379

# --- OBSERVABILIDADE (Futuro) ---
SENTRY_DSN=
APM_SERVER_URL=

# ============================================================================
# 📝 NOTAS IMPORTANTES
# ============================================================================
#
# 1. SEGURANÇA:
#    - Em desenvolvimento: pode usar valores simples
#    - Em produção: gere valores seguros com:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. DATABASE_URL:
#    - Desenvolvimento: mysql://user:pass@localhost:3306/db
#    - Docker: mysql://user:pass@mysql:3306/db
#    - Produção: use valores reais
#
# 3. PORTS:
#    - MySQL: 3306 (padrão)
#    - Adminer: 8080 (interface web)
#    - API: 3001 (será adicionada em Fase 2)
#    - Frontend: 3000 (será adicionada em Fase 2)
#
# 4. Como usar:
#    cp .env.example .env
#    # Editar .env com seus valores
#    docker-compose up
#
# ============================================================================
