# ==============================================================================
# VARIÁVEIS DE AMBIENTE — Template
# ==============================================================================
# Este é um arquivo TEMPLATE. Copie para .env e ajuste os valores
# NUNCA commitar .env no Git — este arquivo é seguro commitar
# ==============================================================================

# ============================================================================
# MYSQL — Configuração do Banco de Dados
# ============================================================================

# Porta do MySQL (padrão 3306)
MYSQL_PORT=3306

# Nome do banco de dados
MYSQL_DATABASE=pilates_db

# Usuário do banco (não root)
MYSQL_USER=pilates_user

# Senha do usuário pilates_user (MUDAR EM PRODUÇÃO!)
MYSQL_PASSWORD=pilates_pass

# Senha do root (MUDAR EM PRODUÇÃO!)
MYSQL_ROOT_PASSWORD=root123

# ============================================================================
# ADMINER — Interface Web de Gerenciamento
# ============================================================================

# Porta do Adminer (padrão 8080)
ADMINER_PORT=8080

# ============================================================================
# NODE.JS — Backend (Fase 2)
# ============================================================================

# Environment (development | staging | production)
NODE_ENV=development

# Porta do servidor backend
BACKEND_PORT=3000

# URL do banco para Prisma (IMPORTANTE: use 'mysql' quando em Docker)
DATABASE_URL=mysql://pilates_user:pilates_pass@mysql:3306/pilates_db

# JWT Secret (gerar com: openssl rand -base64 32)
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_32_caracteres_minimo

# JWT Token Expiry
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ============================================================================
# REACT — Frontend (Fase 2)
# ============================================================================

# Porta do servidor frontend (dev)
FRONTEND_PORT=5173

# URL da API backend (IMPORTANTE: localhost quando dev local)
VITE_API_URL=http://localhost:3000/api/v1

# ============================================================================
# LOGGING — Configuração de Logs
# ============================================================================

# Nível de log (debug | info | warn | error)
LOG_LEVEL=info

# ============================================================================
# CORS — Segurança
# ============================================================================

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================================
# EMAIL — Notificações (Opcional - Fase 3+)
# ============================================================================

# SMTP Server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_app

# ============================================================================
# INSTRUÇÕES
# ============================================================================
# 
# 1. Copiar este arquivo para .env (na mesma pasta):
#    cp .env.example .env
#
# 2. Editar .env com seus valores (NÃO editar .env.example)
#
# 3. Para desenvolvimento local, os valores padrão funcionam
#
# 4. Gerar JWT_SECRET seguro:
#    openssl rand -base64 32
#
# 5. Variáveis importantes para Docker:
#    - DATABASE_URL: usar 'mysql' como hostname (nome do container)
#    - VITE_API_URL: usar localhost para dev local
#
# 6. Em produção:
#    - Mudar todas as senhas
#    - Usar variáveis de ambiente do servidor
#    - Nunca commitar .env
#
# ==============================================================================
